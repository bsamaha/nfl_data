#!/bin/sh
# Runs before every commit in a clone where `git config core.hooksPath .githooks` has been set.
# A commit that fails a step is not made, and the step says what to run. The files checked are the ones on disk.

uv run ruff format --check || {
    echo "pre-commit: run 'uv run ruff format', stage the result and commit again" >&2
    exit 1
}
uv run ruff check || {
    echo "pre-commit: fix what ruff reports ('uv run ruff check --fix' fixes some), stage it and commit again" >&2
    exit 1
}
uv run pytest -q || {
    echo "pre-commit: a test fails; fix the code or the test and commit again" >&2
    exit 1
}
